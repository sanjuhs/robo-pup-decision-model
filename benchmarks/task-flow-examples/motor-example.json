    "import json\nfrom pathlib import Path\nimport numpy as np\nfrom stable_baselines3 import PPO\nimport torch\ntorch.set_num_threads(1)\nrecord = json.loads(Path(\"benchmarks/task-flow-examples/examples.json\").read_text())\nobs = np.asarray(record[\"scene\"][\"motor_observation_50\"], dtype=np.float32)\nmodel = PPO.load(\"demo/curious-v2/policy.zip\", device=\"cpu\")\nfor forward in (0.0, 0.35):\n    inputs = obs.copy()\n    inputs[33], inputs[34] = forward, 0.0\n    action, _ = model.predict(inputs, deterministic=True)\n    print(json.dumps({\"forward_command_input\": forward,\n                      \"normalized_joint_residuals_12\": action.tolist(),\n                      \"scaled_joint_adjustments_rad_12\": (action * 0.3).tolist()}))\n"
