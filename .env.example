# Copy privately to your host's secret settings. Never commit real values.
# Needed only for Runpod operations; the local demo does not require this.
RUNPOD_API_KEY=
# Needed only to publish into your personal Vercel account.
VERCEL_TOKEN=
# Optional: gated/private models or Hugging Face publishing. Public Qwen needs none.
HF_TOKEN=

# Live physics backend: use a strong private workshop key before public hosting.
ROBOPUP_ARENA_TOKEN=
ROBOPUP_ALLOWED_ORIGINS=
ROBOPUP_BACKEND_URL=
# Public frontend URL setting. Never put a token in any VITE_ variable.
VITE_ARENA_BACKEND_URL=

# Native local VLM. The explicit downloader creates this ignored directory.
ROBOPUP_VLM_MODEL_DIR=artifacts/vlm/Qwen3-VL-2B-Instruct
ROBOPUP_VLM_MODEL=Qwen/Qwen3-VL-2B-Instruct
ROBOPUP_VLM_CPU_THREADS=2
ROBOPUP_VLM_TIMEOUT_S=180
# Optional: float32, bfloat16, auto. BF16 was tested on the development Xeon CPU.
ROBOPUP_VLM_DTYPE=
# Use vlm to select generative mode by default; neural keeps the compact arena.
ROBOPUP_DEFAULT_BRAIN=neural

# Alternative remote vision provider; backend only, never exposed to the browser.
ROBOPUP_VLM_BASE_URL=
ROBOPUP_VLM_API_KEY=
# PLANNER_URL is injected by the Vercel service binding. Do not set it yourself.
